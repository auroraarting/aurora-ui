NEXT_PUBLIC_STRAPI_DO_BASE_URL=
STRAPI_DO_BASE_URL=

NEXT_PUBLIC_AUTH_TOKEN=
AUTH_TOKEN=

NEXT_PUBLIC_DOMAIN_URL=
# WordPress wp/v2 REST base — required. Every service in src/services/rest
# builds its URLs from this, and a build fails on the first call without it.
REST_API_URL=https://cms-production.auroraer.com/wp-json/wp/v2

# GraphQL, still used by the home page's siblings and the two /[language]
# routes. GraphQLAPI posts through the Redis cache rather than to API_URL
# directly, so both are needed.
API_URL=
REDIS_URL=

# On-demand revalidation. When set, /api/revalidate requires it as ?secret= or
# an x-revalidate-secret header; the WordPress hook must send the same value.
REVALIDATE_SECRET=

# Outbound pacing for REST calls (see src/services/rest/limiter.js). Defaults
# are build: 1 concurrent, 1 request/second; runtime: 3 concurrent, no rate cap.
WP_REST_CONCURRENCY=
WP_REST_MIN_INTERVAL_MS=
WP_REST_PAUSE_MS=
WP_REST_LOG=
