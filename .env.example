# WordPress / WPGraphQL
API_URL=
AUTH_TOKEN=

# Shared Redis cache proxy that sits in front of WPGraphQL.
REDIS_URL=

# Prefixes cache keys so staging and production don't share entries.
NEXT_PUBLIC_SITE_ENV=

# Shared secret for GET /api/revalidate. Until this is set on both this app and
# the WordPress webhook, the purge endpoint is callable by anyone, which means
# anyone can force every page to refetch from WordPress at once.
REVALIDATE_SECRET=

# Forms
CONTACT_FORM_API=
PRESS_ROOM_SUBSCRIBE_FORM_API=
SENDGRID_API_KEY=

# Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
